{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Silens",
  "version": "1.2.1",
  "identifier": "com.weihusong.sliens",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Silens",
        "width": 800,
        "height": 600,
        "resizable": true,
        "visible": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxMUEwQjY4RjlDOEE0MkMKUldRc3BNajVhQXNhSWQxZ3dka0M4d3VKY0RxQWF3aUx6MWx2dDhiSWZKbUxaNE9qbS81TVNhSEQK",
      "endpoints": ["https://github.com/weihus/Silens/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
